<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv="clr-namespace:WebViewControl;assembly=WebViewControl.Avalonia"
             xmlns:vm="using:ECoopSystem.ViewModels"
             x:DataType="vm:MainViewModel"
             MinWidth="1280" MinHeight="720"
             x:Class="ECoopSystem.Views.MainView">

    <Grid RowDefinitions="*" ColumnDefinitions="*">

        <!-- WebView container - will be populated dynamically after CEF is ready -->
        <ContentControl x:Name="webViewContainer" />

        <Border IsVisible="{Binding IsLoading}">
            <Border.Background>
                <ImageBrush Source="avares://ECoopSystem/Assets/Images/loading-bg.jpg" Stretch="UniformToFill"/>
            </Border.Background>
            <Grid>
                <Image Source="avares://ECoopSystem/Assets/Images/loading-logo.png"
                       Width="180" Height="180"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,0,0,150"/>

                <StackPanel VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Spacing="16" Margin="0,0,0,20">
                    <StackPanel Spacing="24">
                        <TextBlock Text="BUILT IN TRUST"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="White" HorizontalAlignment="Center"/>

                        <TextBlock Text="POWERED BY LANDS HORIZON CORP 2026."
                                   FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                    
                    <ProgressBar IsIndeterminate="True"
                                 Width="200" Height="4"
                                 HorizontalAlignment="Center" Background="White"
                                 Foreground="#50e893"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>