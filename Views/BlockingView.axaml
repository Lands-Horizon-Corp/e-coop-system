<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ECoopSystem.ViewModels"
             x:DataType="vm:BlockingViewModel"
             x:Class="ECoopSystem.Views.BlockingView"
             MinWidth="1280" MinHeight="720">

  <Grid>
    <Border>
      <Border.Background>
        <ImageBrush Source="avares://ECoopSystem/Assets/Images/loading-bg.jpg" Stretch="UniformToFill"/>
      </Border.Background>
    </Border>

    <Border Background="#B2182430"/>

    <Border MaxWidth="620"
            Padding="28"
            Background="#CC0F1722"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="24">
      <StackPanel Spacing="10" Margin="0,0,0,0">
        <Image Source="avares://ECoopSystem/Assets/Images/loading-logo.png"
               Width="110" Height="110"
               HorizontalAlignment="Center"
               Margin="0,0,0,4"/>

        <TextBlock Text="{Binding Title}"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>

        <Border Background="#1038BDF8"
                BorderBrush="#4038BDF8"
                BorderThickness="1"
                CornerRadius="999"
                Padding="14,6"
                HorizontalAlignment="Center"
                Margin="0,6,0,10">
          <TextBlock Text="{Binding Message}"
                     FontSize="12"
                     Foreground="#BFDBFE"
                     FontWeight="SemiBold"
                     TextAlignment="Center"/>
        </Border>

        <Border Background="#1A50E893"
                BorderBrush="#6050E893"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,2,0,0">
          <TextBlock Text="Unable to reach ECoop server right now. Please check your connection and try again."
                     TextWrapping="Wrap"
                     FontSize="12"
                     Foreground="#D1FAE5"
                     TextAlignment="Center"/>
        </Border>

        <TextBlock Text="You can close the app and try again later."
                   FontSize="12"
                   Opacity="0.9"
                   Foreground="#D1D5DB"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
